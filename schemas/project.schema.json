{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/silentiumlabsio/maestro-forge/schemas/project.schema.json",
  "title": "Maestro Forge project metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "author", "repositoryUrl", "commitSha", "status", "trustState", "languages", "security"],
  "properties": {
    "id": {"type":"string","pattern":"^[a-z0-9][a-z0-9-]{2,60}$"},
    "name": {"type":"string","minLength":2,"maxLength":100},
    "author": {"type":"string","pattern":"^@[A-Za-z0-9-]{1,39}$"},
    "description": {"type":"string","minLength":20,"maxLength":400},
    "repositoryUrl": {"type":"string","pattern":"^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/?$"},
    "commitSha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "status": {"enum":["submitted","under-review","active","quarantined","revoked","archived"]},
    "trustState": {"enum":["Untrusted","Metadata Reviewed","Scanned","Human Reviewed","Verified","Quarantined","Revoked","Archived"]},
    "languages": {"type":"array","items":{"type":"string","minLength":1,"maxLength":40},"uniqueItems":true,"maxItems":12},
    "security": {
      "type":"object","additionalProperties":false,
      "required":["networkAccess","filesystemRead","filesystemWrite","shellExecution","authentication","storesUserData","requiresSecrets"],
      "properties": {
        "networkAccess":{"type":"boolean"},"filesystemRead":{"type":"boolean"},"filesystemWrite":{"type":"boolean"},
        "shellExecution":{"type":"boolean"},"authentication":{"type":"boolean"},"storesUserData":{"type":"boolean"},"requiresSecrets":{"type":"boolean"}
      }
    },
    "dependencies":{"type":"array","items":{"type":"string","maxLength":100},"uniqueItems":true,"maxItems":100}
  }
}
